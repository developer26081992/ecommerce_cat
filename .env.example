# Leave both values unset to explore the bundled demo catalogue.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
# Only needed for the local image upload and verification scripts; never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively, the scripts accept SUPABASE_SECRET_KEY for projects using new secret keys.
# The website itself only uses the public URL and publishable key.
