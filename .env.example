# Leave both values unset to explore the bundled demo catalogue.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
# Used only by trusted server checkout/webhook code and local setup scripts; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively, the scripts accept SUPABASE_SECRET_KEY for projects using new secret keys.
# Authentication and catalogue reads use the public URL and publishable key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Local value comes from Stripe CLI; deployed value comes from the deployed webhook endpoint.
STRIPE_WEBHOOK_SECRET=
